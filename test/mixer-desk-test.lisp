;;;; test/mixer-desk-test.lisp -- the Mixer as a desk app: it shows a source's level, and its hand works.
;;;;   sbcl --non-interactive --load test/mixer-desk-test.lisp     (exits 0 iff every check passes)

(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(push (make-pathname :name nil :type nil
                     :defaults (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*)))
      asdf:*central-registry*)
(handler-bind ((warning #'muffle-warning))
  (let ((*standard-output* (make-broadcast-stream))) (asdf:load-system :glass/mixer-desk)))

(defpackage #:glass-mixer-desk-test (:use #:cl))
(in-package #:glass-mixer-desk-test)
(defvar *fails* 0)
(defun check (name ok) (format t "~&MIXER ~:[FAIL~;ok  ~] ~a~%" ok name) (unless ok (incf *fails*)))

(let* ((m (glass:make-mixer :rate 48000))
       (sink (glass:mixer-subscribe m :name "speaker" :rate 48000))
       (tone (glass:mixer-play m (glass:audio-tone 440 5) :name "tone"))
       (fb (glass:make-framebuffer 400 400)))
  (declare (ignorable sink))
  (dotimes (i 5) (glass:mixer-tick m))
  (check "a playing source has a level" (> (glass:src-level tone) 0.1d0))
  (multiple-value-bind (on-key on-pointer tick) (glass.desk:mixer-app fb m)
    (declare (ignore on-key))
    (check "it draws" (funcall tick))
    (flet ((tap (x y) (funcall on-pointer 1 x y) (funcall on-pointer 0 x y))
           (heard () (glass:mix-hears-p (glass:as-mix m) tone))
           (gain () (glass:mix-source-gain (glass:as-mix m) tone)))
      ;; the first source's row: its mute box at 12,72 (Out row, then Sources' heading), - and + at its right
      (tap 20 80)
      (check "the box mutes it" (not (heard)))
      (dotimes (i 5) (glass:mixer-tick m))
      (check "and the mix is silent" (< (glass:mixer-level m) 0.001d0))
      (funcall tick)
      (tap 20 80)
      (check "tapped again, heard again" (heard))
      (funcall tick)
      (tap (+ (- 400 148) 10) 80) (funcall tick)
      (tap (+ (- 400 148) 10) 80) (funcall tick)
      (check "- turns it down, a tenth a tap" (< (abs (- (gain) 0.8d0)) 1d-9))
      (tap 20 80) (funcall tick) (tap 20 80) (funcall tick)
      (check "muted and back: the gain it had, not full" (< (abs (- (gain) 0.8d0)) 1d-9))
      (dotimes (i 5) (tap (+ (- 400 148) 110) 80) (funcall tick))
      (check "+ turns it up" (< (abs (- (gain) 1.3d0)) 1d-9))
      (dotimes (i 10) (glass:mixer-tick m))
      (check "the mix hears it, louder" (> (glass:mixer-level m) 0.1d0)))))

(format t "~&MIXER ~:[FAIL (~d)~;PASS~]~%" (zerop *fails*) *fails*)
(sb-ext:exit :code (if (zerop *fails*) 0 1))
