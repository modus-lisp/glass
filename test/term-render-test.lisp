;;;; test/term-render-test.lisp — glass/term's RENDER draws only what changed, and that is
;;;; always what a full redraw would draw.
;;;;   sbcl --non-interactive --load test/term-render-test.lisp   (exits 0 iff every check passes)
;;;; (with glass and scribe findable by ASDF)

(require :asdf)
(handler-bind ((warning #'muffle-warning))
  (let ((*standard-output* (make-broadcast-stream))) (asdf:load-system :glass/term)))

(defpackage #:glass-term-render-test (:use #:cl))
(in-package #:glass-term-render-test)

(defvar *fails* 0)
(defun check (name ok)
  (format t "~&TERM-RENDER ~:[FAIL~;ok  ~] ~a~%" ok name)
  (unless ok (incf *fails*)))

(let* ((tm (glass-term::make-terminal :cols 30 :rows 6 :ppem 14 :pty (lambda (s) s) :nerd-font nil))
       (fb (glass-term::terminal-fb tm)) (ok t) (steps 0))
  (flet ((feed (s) (loop for c across s do (glass-term::feed-cp tm (char-code c))))
         (same-as-full ()
           (glass-term::render tm)
           (let ((partial (copy-seq (glass:fb-pixels fb))))
             (setf (glass-term::terminal-drawn-chars tm) nil)
             (glass-term::render tm)
             (incf steps)
             (equalp partial (glass:fb-pixels fb)))))
    (glass-term::render tm) (glass-term::terminal-take-dirty tm)
    (glass-term::render tm)
    (check "an idle render with the cursor showing draws nothing" (not (glass-term::terminal-take-dirty tm)))
    (dolist (s (list "hello" (format nil "~%world") (format nil "~c[2;4H" (code-char 27))
                     (format nil "~c[?25l" (code-char 27)) "X" (format nil "~c[?25h" (code-char 27))
                     (format nil "~c[1;31mred~c[0m" (code-char 27) (code-char 27))
                     (format nil "~c[6;1H~%~%scrolled" (code-char 27)) (format nil "~c[2J" (code-char 27))
                     "" (format nil "~c[3;3H" (code-char 27))))
      (feed s)
      (unless (same-as-full) (setf ok nil)))
    (check "incremental render equals a full redraw, step by step" (and ok (= steps 11)))
    (glass-term::terminal-take-dirty tm)
    (glass-term::render tm)
    (check "and settles: nothing to draw once drawn" (not (glass-term::terminal-take-dirty tm)))
    (feed (format nil "~c[4;5H" (code-char 27)))
    (glass-term::render tm)
    (check "a cursor move alone is drawn" (glass-term::terminal-take-dirty tm))))

(format t "~&TERM-RENDER ~:[FAIL (~d)~;PASS~]~%" (zerop *fails*) *fails*)
(uiop:quit (if (zerop *fails*) 0 1))
