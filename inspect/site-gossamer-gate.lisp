;;;; site-gossamer-gate.lisp — the site key is never on the heap: publish, then look for it.
;;;;
;;;;   sbcl --non-interactive --load inspect/site-gossamer-gate.lisp
;;;;
;;;; The rule this checks is the user's: "secrets aren't supposed to be on the heap, they're supposed
;;;; to be in separate memory that doesn't get copied around."  It is checked the only way a claim
;;;; about where bytes are NOT can be checked — by publishing with a key and then reading every byte
;;;; of the collector's memory for it:
;;;;
;;;;   1. A THROWAWAY key is generated by read(2) from /dev/urandom straight into a gossamer buffer
;;;;      and written to a temp key file from there, so this test never puts it on the heap either.
;;;;      The needles the scan looks for (the 32 key bytes, their hex as ASCII and as SBCL's 32-bit
;;;;      characters) are built in gossamer memory too: the haystack is the moving heap, and nothing
;;;;      the test holds is in it — so the expected count is ZERO, not "no more than a baseline".
;;;;   2. GLASS:PUBLISH-SITE-FILE publishes against a LOCAL fake relay and fake Blossom server
;;;;      (site-fakes.lisp) that verify every signature.  No network.
;;;;   3. Then the whole of SBCL's dynamic space up to its high-water page — live objects, garbage,
;;;;      and free pages alike, which is where a copying collector's leftovers would be — is scanned
;;;;      for each HALF of each needle, before and after a full GC.  Static space (where gossamer
;;;;      lives) is scanned too, minus the needles themselves: every buffer the publish used must be
;;;;      back to zero.
;;;;   4. A positive control at the end makes the old kind of copy (READ-LINE of the key file, a heap
;;;;      COPY-SEQ of the key) and shows the same scanner finds it — so "zero hits" means something.
;;;;
;;;; THE REAL SITE KEY IS NEVER READ.  *SITE-KEY-FILE* is bound into a temp directory, $GLASS_SITE_SEC
;;;; and $SITE_SEC are removed from this process's environment first, and there are assertions on
;;;; both before anything is published.

(require :asdf)
(unless (find-package "QL") (load "~/quicklisp/setup.lisp"))
(handler-bind ((warning #'muffle-warning))
  (let ((*standard-output* (make-broadcast-stream)))
    (asdf:load-system :glass/site)))
(load (merge-pathnames "site-fakes.lisp" *load-truename*))

(defpackage #:glass-site-gossamer-gate (:use #:cl)) (in-package #:glass-site-gossamer-gate)

(defvar *pass* 0) (defvar *fail* 0)
(defun ok (name p &optional detail)
  (if p (progn (incf *pass*) (format t "  ok   ~a~@[ — ~a~]~%" name detail))
      (progn (incf *fail*) (format t "  FAIL ~a~@[ — ~a~]~%" name detail)))
  (finish-output))
(defun banner (s) (format t "~&~%== ~a ==~%" s))

;;; ---- the fixture: a temp directory, and nothing of the real site --------------

(defparameter *dir* (format nil "/tmp/glass-site-gossamer-~d/" (sb-posix:getpid)))
(ensure-directories-exist *dir*)
(defparameter *key-file* (concatenate 'string *dir* "site-key"))
(defparameter *url-file* (concatenate 'string *dir* "site-url"))
(defparameter *page-file* (concatenate 'string *dir* "nsite-index.html"))
(defparameter *real-key-file* (namestring (merge-pathnames ".glass/site-key" (user-homedir-pathname))))
(defparameter *real-site-npub* "npub1ajvjnhgcmdxkng22lzsh22qvl63es78gk6p9mwksepju974teguq4l4evc")

(sb-posix:unsetenv "GLASS_SITE_SEC")
(sb-posix:unsetenv "SITE_SEC")
(setf glass:*site-key-file* *key-file*
      glass:*site-url-file* *url-file*
      glass:*site-npub* nil
      glass:*login-url-base* nil
      glass:*last-site-publication* nil)

;;; ---- raw memory, outside the heap ------------------------------------------------

(defun %write-fixed (fd buf start end)
  (sb-sys:with-pinned-objects (buf)
    (sb-unix:unix-write fd (sb-sys:vector-sap buf) start (- end start))))

(defun hex-digit (v) (if (< v 10) (+ 48 v) (+ 87 v)))

;; The key, generated straight into gossamer memory.  A scalar of 0 or >= n is astronomically rare;
;; draw again if it happens.
(defparameter *key* (gossamer:make-fixed-octets 32))
(loop (glass::%read-into-fixed "/dev/urandom" *key*)
      (when (ignore-errors (cl-nostr.keys:public-key-of-secret *key*)) (return)))
;; Its hex, as ASCII octets and as SBCL character-string data (32 bits per character), also fixed.
(defparameter *hex* (gossamer:make-fixed-octets 65))      ; + a NUL, for setenv(3)
(defparameter *hex32* (gossamer:make-fixed-octets 256))
(dotimes (i 32)
  (let ((hi (hex-digit (ash (aref *key* i) -4))) (lo (hex-digit (logand (aref *key* i) 15))))
    (setf (aref *hex* (* 2 i)) hi (aref *hex* (1+ (* 2 i))) lo
          (aref *hex32* (* 8 i)) hi (aref *hex32* (+ 4 (* 8 i))) lo)))

(defparameter *pubkey-hex* (cl-nostr.util:bytes->hex (cl-nostr.keys:public-key-of-secret *key*)))

;; The key file, written from the fixed buffer by write(2): a comment line (public), then the hex.
(let ((fd (sb-unix:unix-open *key-file* (logior sb-unix:o_wronly sb-unix:o_creat sb-unix:o_trunc) #o600))
      (comment (map '(vector (unsigned-byte 8)) #'char-code (format nil "# a throwaway key for site-gossamer-gate~%"))))
  (sb-unix:unix-write fd comment 0 (length comment))
  (%write-fixed fd *hex* 0 64)
  (sb-unix:unix-write fd (make-array 1 :element-type '(unsigned-byte 8) :initial-element 10) 0 1)
  (sb-unix:unix-close fd))

(with-open-file (s *page-file* :direction :output :if-exists :supersede)
  (write-string "<!doctype html><title>site-gossamer-gate</title><p>a page nobody will see" s))

;;; ---- the scanner -----------------------------------------------------------------

(defun %needles ()
  "(name base length) for each HALF of each needle: half a key is still a copy of a key."
  (let ((k (sb-sys:sap-int (sb-sys:vector-sap *key*)))
        (h (sb-sys:sap-int (sb-sys:vector-sap *hex*)))
        (w (sb-sys:sap-int (sb-sys:vector-sap *hex32*))))
    (list (list "key bytes [0,16)" k 16) (list "key bytes [16,32)" (+ k 16) 16)
          (list "hex ASCII [0,32)" h 32) (list "hex ASCII [32,64)" (+ h 32) 32)
          (list "hex UTF-32 [0,32)" w 128) (list "hex UTF-32 [32,64)" (+ w 128) 128))))

(defun %exclusions ()
  "The needles' own bytes (they are in static space, which the second scan covers)."
  (mapcar (lambda (v) (let ((a (sb-sys:sap-int (sb-sys:vector-sap v)))) (cons a (+ a (length v)))))
          (list *key* *hex* *hex32*)))

(defun %scan (from to needle-base needle-len exclusions)
  "Addresses in [FROM,TO) where the NEEDLE-LEN bytes at NEEDLE-BASE occur, outside EXCLUSIONS."
  (declare (type (unsigned-byte 62) from to needle-base) (type fixnum needle-len)
           (optimize (speed 3) (safety 0)))
  (let ((first (sb-sys:sap-ref-8 (sb-sys:int-sap needle-base) 0))
        (hits '()))
    (loop for a of-type (unsigned-byte 62) from from below (- to needle-len)
          when (and (= first (sb-sys:sap-ref-8 (sb-sys:int-sap a) 0))
                    (loop for j of-type fixnum from 1 below needle-len
                          always (= (sb-sys:sap-ref-8 (sb-sys:int-sap (+ a j)) 0)
                                    (sb-sys:sap-ref-8 (sb-sys:int-sap (+ needle-base j)) 0)))
                    (notany (lambda (r) (and (<= (car r) a) (< a (cdr r)))) exclusions))
            do (push a hits))
    hits))

(defun dynamic-range ()
  "SBCL's dynamic space up to its high-water page: every page a collection has ever used, live or
free.  Garbage and free pages are included on purpose — that is where a copy would be left."
  (let ((pages (sb-alien:extern-alien "next_free_page" sb-alien:long)))
    (values sb-vm:dynamic-space-start
            (+ sb-vm:dynamic-space-start (* pages sb-vm:gencgc-page-bytes)))))

(defun static-range ()
  (values sb-vm:static-space-start (sb-sys:sap-int sb-vm:*static-space-free-pointer*)))

(defun heap-hits ()
  "(name . count) per needle half, over the whole dynamic space."
  (multiple-value-bind (from to) (dynamic-range)
    (loop for (name base len) in (%needles)
          collect (cons name (length (%scan from to base len '()))))))

(defun static-hits ()
  "(name . count) per needle half, over static space minus the needles themselves."
  (multiple-value-bind (from to) (static-range)
    (loop for (name base len) in (%needles)
          collect (cons name (length (%scan from to base len (%exclusions)))))))

(defun total (hits) (reduce #'+ hits :key #'cdr))
(defun say-hits (hits) (format nil "~{~a~^, ~}" (mapcar (lambda (h) (format nil "~a: ~d" (car h) (cdr h))) hits)))

;;; ==============================================================================
(banner "the fixture: a throwaway key, and the real site nowhere near it")
;;; ==============================================================================

(ok "the site key file is the temp one" (equal glass:*site-key-file* *key-file*))
(ok "  …not ~/.glass/site-key" (not (equal (namestring (truename glass:*site-key-file*)) *real-key-file*)))
(ok "$GLASS_SITE_SEC and $SITE_SEC are unset here"
    (and (null (sb-posix:getenv "GLASS_SITE_SEC")) (null (sb-posix:getenv "SITE_SEC"))))
(ok "the key and the needles are in gossamer (static) memory"
    (every #'gossamer:fixed-p (list *key* *hex* *hex32*)))
(ok "the throwaway key is not the live site's"
    (not (equal *real-site-npub* (glass:site-npub :cache nil))))
(multiple-value-bind (from to) (dynamic-range)
  (format t "  --   dynamic space scanned: ~,1f MB at #x~x; static: ~d KB~%"
          (/ (- to from) 1048576.0) from
          (multiple-value-bind (a b) (static-range) (round (- b a) 1024))))
(let ((h (heap-hits)))
  (ok "BEFORE anything: the key is nowhere on the heap" (zerop (total h)) (say-hits h)))

;;; ==============================================================================
(banner "the API: the key is lent to a body, never returned")
;;; ==============================================================================

(ok "SITE-SECRET is gone — it signals rather than hand out a heap copy"
    (handler-case (progn (glass:site-secret) nil) (error () t)))
(ok "WITH-SITE-SECRET lends a keypair whose secret is in gossamer memory"
    (glass:with-site-secret (kp)
      (and kp (gossamer:fixed-p (cl-nostr.keys:keypair-secret-key kp)))))
(ok "  …that is THIS key" (glass:with-site-secret (kp) (equal *pubkey-hex* (cl-nostr.keys:public-hex kp))))
(defvar *escaped* nil)
(defvar *escaped-buffer* nil)
(glass:with-site-secret (kp) (setf *escaped* kp *escaped-buffer* (cl-nostr.keys:keypair-secret-key kp)))
(ok "  …and after the body the keypair is wiped: its secret is NIL"
    (null (cl-nostr.keys:keypair-secret-key *escaped*)))
(ok "  …and the buffer it had is all zeros" (every #'zerop *escaped-buffer*))
(ok "an error inside the body still wipes it"
    (let ((buf nil))
      (ignore-errors (glass:with-site-secret (kp)
                       (setf buf (cl-nostr.keys:keypair-secret-key kp))
                       (error "boom")))
      (and buf (every #'zerop buf))))
(ok "a missing key file is NIL, not an error"
    (null (glass:with-site-secret (kp :file (concatenate 'string *dir* "nope")) kp)))
(ok "a file with something that is not 64 hex is NIL"
    (let ((f (concatenate 'string *dir* "junk")))
      (with-open-file (s f :direction :output :if-exists :supersede) (write-line "not-a-key" s))
      (null (glass:with-site-secret (kp :file f) kp))))
(ok "65 hex digits on the line is NIL, not the first 64"
    (let ((f (concatenate 'string *dir* "long")))
      (with-open-file (s f :direction :output :if-exists :supersede)
        (write-line (make-string 65 :initial-element #\a) s))
      (null (glass:with-site-secret (kp :file f) kp))))
(ok "PUBLISH-SITE refuses a hex-string :SECRET (it is already a heap copy)"
    (handler-case (progn (glass:publish-site (list (cons "/x.html" "x")) :version "x"
                                             :secret (make-string 64 :initial-element #\1)
                                             :servers '() :relays '() :lookup '())
                         nil)
      (error () t)))

;;; ==============================================================================
(banner "publish against a LOCAL relay and Blossom server, signed from gossamer memory")
;;; ==============================================================================

(multiple-value-bind (relay blossom) (glass-site-fakes:start-fakes)
  (format t "  --   fake relay ~a, fake Blossom ~a~%" relay blossom)
  (ok "both fakes are on loopback" (and (search "127.0.0.1" relay) (search "127.0.0.1" blossom)))
  (let ((buffers '()))
    ;; Watch every keypair being wiped, to check its buffer afterwards.
    (sb-int:encapsulate 'cl-nostr.keys:keypair-wipe 'gate
                        (lambda (f kp) (push (cl-nostr.keys:keypair-secret-key kp) buffers) (funcall f kp)))
    (multiple-value-bind (url publication)
        (glass:publish-site-file *page-file* :version "k1"
                                 :relays (list relay) :lookup '() :servers (list blossom))
      (sb-int:unencapsulate 'cl-nostr.keys:keypair-wipe 'gate)
      (ok "the publish landed" url url)
      (ok "  …and moved the link base to it" (and url (equal url glass:*login-url-base*)))
      (ok "  …at the npub of THIS key"
          (equal (cl-nostr.bech32:npub-encode *pubkey-hex*) (glass:site-publication-npub publication)))
      (let* ((events glass-site-fakes:*events*)
             (manifest (find cl-nostr.nsite:+kind-nsite-root+ events :key #'cl-nostr.event:event-kind)))
        (ok "the relay holds a kind-15128 manifest" manifest)
        (ok "  …whose id and BIP-340 signature VERIFY"
            (and manifest (cl-nostr.event:verify-event manifest)))
        (ok "  …signed by this key" (and manifest (equal *pubkey-hex* (cl-nostr.event:event-pubkey manifest))))
        (ok "  …naming /k1.html, /index.html and / at the blob's hash"
            (and manifest
                 (let ((paths (loop for tag in (coerce (cl-nostr.event:event-tags manifest) (quote list))
                                    when (equal (elt tag 0) "path") collect (elt tag 1))))
                   (every (lambda (p) (member p paths :test #'equal)) '("/k1.html" "/index.html" "/")))))
        (ok "every event the relay took verifies (manifest, relay list, server list)"
            (and events (every #'cl-nostr.event:verify-event events)) (format nil "~d events" (length events))))
      (ok "the Blossom server took the page, under a verified kind-24242 authorization by this key"
          (and (= 1 (hash-table-count glass-site-fakes:*blobs*))
               glass-site-fakes:*auth-events*
               (every (lambda (e) (equal *pubkey-hex* (cl-nostr.event:event-pubkey e)))
                      glass-site-fakes:*auth-events*)))
      (ok "the publish wiped exactly the one keypair it read" (= 1 (length buffers)))
      (ok "  …whose gossamer buffer is all zeros now"
          (and buffers (every (lambda (b) (and (gossamer:fixed-p b) (every #'zerop b))) buffers)))
      (ok "the memo names the publish" (equal url (glass:load-site-url :install nil))))))

;;; ==============================================================================
(banner "THE CLAIM: the key's bytes are nowhere in the collector's memory")
;;; ==============================================================================

(let ((h (heap-hits)))
  (ok "after the publish, before any GC: zero hits in all of dynamic space" (zerop (total h)) (say-hits h)))
(sb-ext:gc :full t)
(let ((h (heap-hits)))
  (ok "after a full GC: still zero" (zerop (total h)) (say-hits h)))
(let ((h (static-hits)))
  (ok "and static space (gossamer's pool) holds no copy beyond the test's own needles — every buffer the publish used is zero"
      (zerop (total h)) (say-hits h)))
(multiple-value-bind (allocated free) (gossamer:pool-stats)
  (ok "every pooled buffer went back to the pool" (= allocated free)
      (format nil "~d allocated, ~d free" allocated free)))

;;; ==============================================================================
(banner "the environment path: decoded from C memory, not from a Lisp string")
;;; ==============================================================================
;;; setenv(3) is given the hex from the gossamer buffer by address, so the Lisp heap never holds it.
;;; glibc copies it into the C heap (malloc) — the environment's weakness, documented in site.lisp.

(sb-sys:with-pinned-objects (*hex*)
  (sb-alien:alien-funcall
   (sb-alien:extern-alien "setenv" (function sb-alien:int sb-alien:c-string sb-sys:system-area-pointer sb-alien:int))
   "GLASS_SITE_SEC" (sb-sys:vector-sap *hex*) 1))
(ok "with $GLASS_SITE_SEC set (and no key file), the site npub is this key's"
    (equal (cl-nostr.bech32:npub-encode *pubkey-hex*)
           (glass:site-npub :cache nil :file (concatenate 'string *dir* "nope"))))
(sb-ext:gc :full t)
(let ((h (heap-hits)))
  (ok "  …and the heap still holds no copy of it" (zerop (total h)) (say-hits h)))
(sb-posix:unsetenv "GLASS_SITE_SEC")

;;; ==============================================================================
(banner "positive control: the scanner DOES see the old kind of copy")
;;; ==============================================================================
;;; Last, because it is exactly what the code above must not do: put the key on the heap.

(defvar *control-line* (with-open-file (s *key-file*) (read-line s) (read-line s)))
(defvar *control-bytes* (copy-seq *key*))
(let ((h (heap-hits)))
  (ok "READ-LINE of the key file and a COPY-SEQ of the key are found"
      (and (plusp (cdr (assoc "hex UTF-32 [0,32)" h :test #'string=)))
           (plusp (cdr (assoc "key bytes [0,16)" h :test #'string=))))
      (say-hits h)))

;;; ---- clean up --------------------------------------------------------------------

(gossamer:wipe *key* *hex* *hex32*)
(glass-site-fakes:stop-fakes)
(dolist (f (directory (concatenate 'string *dir* "*"))) (ignore-errors (delete-file f)))
(ignore-errors (sb-posix:rmdir *dir*))

(format t "~&~%~a passed, ~a failed~%" *pass* *fail*)
(finish-output)
(sb-ext:exit :code (if (zerop *fail*) 0 1) :abort t)
